<Window x:Class="IHM.ModifierPieceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modifier la pièce" Height="350" Width="400"
        WindowStartupLocation="CenterScreen" Background="#F5F5F5">

    <Border Background="White" Margin="20" CornerRadius="10" Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" Opacity="0.2" ShadowDepth="3"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="Modifier la pièce" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" Foreground="#333"/>

            <TextBlock Text="Nom de la pièce :" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtNom" Margin="0,5,0,15" Height="30" VerticalContentAlignment="Center" FontSize="14"/>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Prix (€) :" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtPrix" Margin="0,5,0,0" Height="30" VerticalContentAlignment="Center" FontSize="14"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Stock :" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtStock" Margin="0,5,0,0" Height="30" VerticalContentAlignment="Center" FontSize="14"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="État :" FontWeight="SemiBold"/>
            <ComboBox x:Name="CboEtat" Margin="0,5,0,25" Height="30" VerticalContentAlignment="Center" FontSize="14">
                <ComboBoxItem Content="Neuf"/>
                <ComboBoxItem Content="Occasion"/>
            </ComboBox>

            <Button Content="ENREGISTRER LES MODIFICATIONS" Height="45" Background="#28a745" Foreground="White" FontWeight="Bold" Click="BtnEnregistrer_Click" Cursor="Hand"/>
        </StackPanel>
    </Border>
</Window>