<Window x:Class="IHM.ListePiecesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pièces disponibles" Height="500" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock x:Name="TxtTitre" Text="Pièces : [Catégorie]" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

            <DataGrid x:Name="GridPieces" AutoGenerateColumns="False" IsReadOnly="True" Height="350" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nom de la pièce" Binding="{Binding Nom}" Width="*"/>
                    <DataGridTextColumn Header="Prix (€)" Binding="{Binding Prix}" Width="80"/>
                    <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="60"/>
                    <DataGridTextColumn Header="État" Binding="{Binding Etat}" Width="80"/>

                    <DataGridTemplateColumn Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Choisir / Modifier" Click="BtnAction_Click" Background="#007ACC" Foreground="White" FontWeight="Bold" Margin="2" Cursor="Hand"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>

            <Button Content="Retour" Click="BtnRetour_Click" Margin="0,20,0,0" Height="30" Width="100" HorizontalAlignment="Left"/>
        </StackPanel>
    </Grid>
</Window>