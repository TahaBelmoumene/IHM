<Window x:Class="IHM.AjoutClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouveau Client" Height="350" Width="400"
        WindowStartupLocation="CenterScreen" Background="#F5F5F5">

    <Border Background="White" Margin="20" CornerRadius="10" Padding="20">
        <StackPanel>
            <TextBlock Text="Nouveau Client" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" Foreground="#333"/>

            <TextBlock Text="Nom :" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtNom" Margin="0,5,0,10" Height="30" VerticalContentAlignment="Center"/>

            <TextBlock Text="Prénom :" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtPrenom" Margin="0,5,0,10" Height="30" VerticalContentAlignment="Center"/>

            <TextBlock Text="Téléphone :" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtTel" Margin="0,5,0,20" Height="30" VerticalContentAlignment="Center"/>

            <Button Content="ENREGISTRER" Height="40" Background="#28a745" Foreground="White" FontWeight="Bold" Click="BtnEnregistrer_Click"/>
        </StackPanel>
    </Border>
</Window>