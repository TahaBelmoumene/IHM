<Window x:Class="IHM.CreationFactureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouvelle Facture" Height="600" Width="900"
        WindowStartupLocation="CenterScreen" Background="#F5F5F5">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="1. Client" FontSize="18" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,10"/>
            <ComboBox x:Name="CboClients" DisplayMemberPath="Nom" Height="30" Margin="0,0,0,20"/>

            <Separator Margin="0,0,0,20"/>

            <TextBlock Text="2. Ajouter un article" FontSize="18" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,10"/>

            <TextBlock Text="Pièce :" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="3" Height="30" Width="190" Margin="0,0,10,0" Padding="5" Background="White">
                    <TextBlock x:Name="TxtPieceSelectionnee" Text="Aucune pièce sélectionnée" VerticalAlignment="Center" FontStyle="Italic" TextTrimming="CharacterEllipsis"/>
                </Border>
                <Button Content="🔍 Rechercher" Click="BtnRechercherPiece_Click" Width="100" Background="#6C757D" Foreground="White" Cursor="Hand"/>
            </StackPanel>

            <TextBlock Text="État / TVA :" FontWeight="SemiBold" Margin="0,5,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,15">
                <RadioButton x:Name="RadioNeuf" Content="Neuf (TVA 20%)" GroupName="EtatGroup" IsChecked="True" Margin="0,0,15,0"/>
                <RadioButton x:Name="RadioOccasion" Content="Occasion (Marge)" GroupName="EtatGroup"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Quantité :" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtQte" Text="1" Height="30" Margin="0,5,0,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="2" Content="AJOUTER" Click="BtnAjouterLigne_Click" Background="#007ACC" Foreground="White" FontWeight="Bold" Height="30" VerticalAlignment="Bottom" Cursor="Hand"/>
            </Grid>

        </StackPanel>

        <Border Grid.Column="2" Background="White" CornerRadius="5" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Détail de la facture" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                <DataGrid x:Name="GridPanier" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pièce" Binding="{Binding DescriptionComplete}" Width="*"/>
                        <DataGridTextColumn Header="Qté" Binding="{Binding Quantite}" Width="50"/>
                        <DataGridTextColumn Header="Prix U." Binding="{Binding PrixUnitaire}" Width="80"/>
                        <DataGridTextColumn Header="Total Ligne" Binding="{Binding TotalLigne}" Width="80"/>

                        <DataGridTemplateColumn Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="X" Click="BtnSupprimerLigne_Click" Background="#D9534F" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,20,0,20">
                    <TextBlock Text="TOTAL À PAYER :" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TxtTotal" Text="0,00 €" FontSize="24" FontWeight="Bold" Foreground="#28a745"/>
                </StackPanel>

                <Button Grid.Row="3" Content="VALIDER ET ENREGISTRER LA FACTURE" Height="50" Background="#28a745" Foreground="White" FontSize="16" FontWeight="Bold" Click="BtnValiderFacture_Click" Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>